@model LTW_25DH110785.Areas.Admin.Models.CategoryFormVM
@{ bool edit = ViewBag.IsEdit == true; ViewBag.Title = edit ? "Sửa danh mục" : "Thêm danh mục"; }
<div class="page-heading"><div><p class="eyebrow">CẤU TRÚC CỬA HÀNG</p><h1>@ViewBag.Title<span>.</span></h1></div><a class="button secondary" href="@Url.Action("Index", "Categories", new { area = "Admin" })">← Danh sách</a></div>
@using (Html.BeginForm(edit ? "Edit" : "Create", "Categories", new { area = "Admin", id = Model.CategoryID }, FormMethod.Post, new { @class = "panel form-panel narrow" })) { @Html.AntiForgeryToken() @Html.HiddenFor(m => m.CategoryID) @Html.ValidationSummary(false, "", new { @class = "validation-summary" })<div class="field">@Html.LabelFor(m => m.CategoryName, "Tên danh mục") @Html.TextBoxFor(m => m.CategoryName, new { maxlength = 100, required = "required", placeholder = "Ví dụ: RAM, SSD, Card đồ họa" }) @Html.ValidationMessageFor(m => m.CategoryName)</div><div class="form-actions"><a class="button secondary" href="@Url.Action("Index", "Categories", new { area = "Admin" })">Hủy</a><button class="button primary" type="submit">Lưu danh mục →</button></div> }
