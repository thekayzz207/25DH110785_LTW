@model System.Collections.Generic.List<LTW_25DH110785.Models.Category>
@{ ViewBag.Title = "Danh mục"; }
<div class="page-heading"><div><p class="eyebrow">CẤU TRÚC CỬA HÀNG</p><h1>Danh mục sản phẩm<span>.</span></h1><p>Nhóm linh kiện để khách hàng dễ tìm kiếm.</p></div><a class="button primary" href="@Url.Action("Create", "Categories", new { area = "Admin" })">+ Thêm danh mục</a></div>
<section class="panel"><div class="table-scroll"><table><thead><tr><th>Mã danh mục</th><th>Tên danh mục</th><th>Thao tác</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td class="muted">#@item.CategoryID</td><td class="strong">@item.CategoryName</td><td><div class="actions"><a class="button small secondary" href="@Url.Action("Edit", "Categories", new { area = "Admin", id = item.CategoryID })">Sửa</a>@using (Html.BeginForm("Delete", "Categories", new { area = "Admin", id = item.CategoryID }, FormMethod.Post, new { onsubmit = "return confirm('Xóa danh mục này?');" })) { @Html.AntiForgeryToken()<button class="button small danger" type="submit">Xóa</button> }</div></td></tr> }@if (!Model.Any()) { <tr><td colspan="3" class="empty">Chưa có danh mục sản phẩm.</td></tr> }</tbody></table></div></section>
