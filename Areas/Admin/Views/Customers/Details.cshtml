@model LTW_25DH110785.Models.Customer
@{ ViewBag.Title = "Hồ sơ khách hàng"; }
<div class="page-heading"><div><p class="eyebrow">HỒ SƠ KHÁCH HÀNG #@Model.CustomerID</p><h1>@Model.CustomerName<span>.</span></h1><p>Tài khoản @Model.Username</p></div><a class="button secondary" href="@Url.Action("Index", "Customers", new { area = "Admin" })">← Danh sách</a></div>
<div class="detail-grid"><section class="panel padded"><h2>Thông tin liên hệ</h2><dl class="info-list"><div><dt>Họ và tên</dt><dd>@Model.CustomerName</dd></div><div><dt>Điện thoại</dt><dd>@Model.CustomerPhone</dd></div><div><dt>Email</dt><dd>@(String.IsNullOrWhiteSpace(Model.CustomerEmail) ? "Chưa cung cấp" : Model.CustomerEmail)</dd></div><div><dt>Địa chỉ</dt><dd>@(String.IsNullOrWhiteSpace(Model.CustomerAddress) ? "Chưa cung cấp" : Model.CustomerAddress)</dd></div></dl></section><section class="panel padded"><p class="eyebrow">LỊCH SỬ MUA SẮM</p><h2>@ViewBag.OrderCount đơn hàng</h2><p class="muted">Xem các đơn đã đặt và trạng thái xử lý của khách hàng.</p><a class="button primary" href="@Url.Action("Index", "Orders", new { area = "Admin", customerId = Model.CustomerID })">Xem tất cả đơn hàng →</a></section></div>
