@model LTW_25DH110785.Areas.Admin.Models.PagedListVM<LTW_25DH110785.Models.Customer>
@{ ViewBag.Title = "Khách hàng"; }
<div class="page-heading"><div><p class="eyebrow">KẾT NỐI KHÁCH HÀNG</p><h1>Khách hàng<span>.</span></h1><p>@Model.TotalItems hồ sơ khách hàng đã đăng ký.</p></div></div>
<section class="panel"><form class="filterbar" method="get" action="@Url.Action("Index", "Customers", new { area = "Admin" })"><label class="search-field"><span class="sr-only">Tìm khách hàng</span><input name="q" value="@Model.Q" placeholder="Tên, tài khoản, email hoặc số điện thoại…"/></label><label><span class="sr-only">Sắp xếp</span>@Html.DropDownList("sort", new[] { new SelectListItem { Text = "Mới nhất", Value = "newest", Selected = Model.Sort == "newest" }, new SelectListItem { Text = "Tên A → Z", Value = "name", Selected = Model.Sort == "name" }, new SelectListItem { Text = "Tên Z → A", Value = "name_desc", Selected = Model.Sort == "name_desc" }, new SelectListItem { Text = "Tên tài khoản", Value = "username", Selected = Model.Sort == "username" } })</label><button type="submit" class="button secondary">Tìm kiếm</button></form><div class="table-scroll"><table><thead><tr><th>Khách hàng</th><th>Tài khoản</th><th>Liên hệ</th><th>Thao tác</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td><a class="table-link" href="@Url.Action("Details", "Customers", new { area = "Admin", id = item.CustomerID })">@item.CustomerName</a><small class="cell-small">#KH-@item.CustomerID.ToString("D4")</small></td><td>@item.Username</td><td>@item.CustomerPhone<small class="cell-small">@item.CustomerEmail</small></td><td><a class="button small secondary" href="@Url.Action("Index", "Orders", new { area = "Admin", customerId = item.CustomerID })">Xem đơn hàng →</a></td></tr> }@if (!Model.Items.Any()) { <tr><td colspan="4" class="empty">Không có khách hàng phù hợp.</td></tr> }</tbody></table></div><div class="pagination"><span>Trang @Model.Page / @Model.TotalPages</span><nav aria-label="Phân trang khách hàng">@if (Model.Page > 1) { <a href="@Url.Action("Index", new { area = "Admin", q = Model.Q, sort = Model.Sort, page = Model.Page - 1 })">← Trước</a> }@for (int p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++) { <a class="@(p == Model.Page ? "current" : "")" href="@Url.Action("Index", new { area = "Admin", q = Model.Q, sort = Model.Sort, page = p })">@p</a> }@if (Model.Page < Model.TotalPages) { <a href="@Url.Action("Index", new { area = "Admin", q = Model.Q, sort = Model.Sort, page = Model.Page + 1 })">Sau →</a> }</nav></div></section>
