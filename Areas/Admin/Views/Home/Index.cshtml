@model LTW_25DH110785.Areas.Admin.Models.DashboardVM
@{ ViewBag.Title = "Tổng quan"; }
<div class="page-heading"><div><p class="eyebrow">CỬA HÀNG CỦA BẠN</p><h1>Tổng quan hoạt động<span>.</span></h1><p>Theo dõi sản phẩm, đơn hàng và khách hàng tại một nơi.</p></div><a class="button primary" href="@Url.Action("Create", "Products", new { area = "Admin" })">+ Thêm sản phẩm</a></div>
<div class="metrics"><article class="metric"><span>Sản phẩm</span><strong>@Model.ProductCount</strong><small>Trong danh mục cửa hàng</small></article><article class="metric"><span>Đơn hàng</span><strong>@Model.OrderCount</strong><small>Tất cả trạng thái</small></article><article class="metric"><span>Khách hàng</span><strong>@Model.CustomerCount</strong><small>Tài khoản đã đăng ký</small></article><article class="metric highlight"><span>Doanh thu đã giao</span><strong class="money">@Model.Revenue.ToString("N0") ₫</strong><small>Đơn hàng giao thành công</small></article></div>
<section class="panel"><div class="panel-heading"><h2>Đơn hàng gần đây</h2><a href="@Url.Action("Index", "Orders", new { area = "Admin" })">Xem tất cả →</a></div><div class="table-scroll"><table><thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Ngày đặt</th><th>Trạng thái</th><th class="right">Giá trị</th></tr></thead><tbody>@foreach (var item in Model.RecentOrders) { <tr><td><a class="table-link" href="@Url.Action("Details", "Orders", new { area = "Admin", id = item.OrderID })">#NX-@item.OrderID.ToString("D5")</a></td><td>@(item.Customer != null ? item.Customer.CustomerName : "—")</td><td>@item.OrderDate.AddHours(7).ToString("dd/MM/yyyy")</td><td><span class="badge">@StatusName(item.OrderStatus)</span></td><td class="right strong">@item.TotalAmount.ToString("N0") ₫</td></tr> }@if (!Model.RecentOrders.Any()) { <tr><td colspan="5" class="empty">Chưa có đơn hàng. Đơn mới sẽ xuất hiện ở đây.</td></tr> }</tbody></table></div></section>
@functions { public string StatusName(string s) { switch (s) { case "Pending": return "Chờ xác nhận"; case "Processing": return "Đang xử lý"; case "Shipping": return "Đang giao"; case "Delivered": return "Đã giao"; case "Cancelled": return "Đã hủy"; default: return s; } } }
