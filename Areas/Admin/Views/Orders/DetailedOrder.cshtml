@model LTW_25DH110785.Models.Order
@{
    ViewBag.Title = "Chi tiết đơn hàng";
    bool isBankTransfer = Model.PaymentMethod == "BankTransfer";
    bool isCod = Model.PaymentMethod == "COD";
    bool isPaid = Model.PaymentStatus == "Paid";
    bool isCancelled = Model.OrderStatus == "Cancelled";
    bool canChangeStatus = LTW_25DH110785.Services.PaymentRules.CanChangeStatus(Model, "Processing")
        || LTW_25DH110785.Services.PaymentRules.CanChangeStatus(Model, "Shipping")
        || LTW_25DH110785.Services.PaymentRules.CanChangeStatus(Model, "Delivered")
        || LTW_25DH110785.Services.PaymentRules.CanChangeStatus(Model, "Cancelled");
}
<div class="admin-orders-page admin-orders-detail">
<div class="page-heading">
    <div>
        <p class="eyebrow">ĐƠN HÀNG / @Model.OrderDate.AddHours(7).ToString("dd.MM.yyyy HH:mm") (UTC+7)</p>
        <h1>#NX-@Model.OrderID.ToString("D6")<span>.</span></h1>
        <p><span class="badge">@StatusName(Model.OrderStatus)</span> · @PaymentMethodName(Model.PaymentMethod)</p>
    </div>
    <a class="button secondary" href="@Url.Action("Index", "Orders", new { area = "Admin", customerId = Model.CustomerID })">← Đơn của khách hàng</a>
</div>
@if (isCancelled && isPaid)
{
    <div class="notice error" role="alert">
        <strong>Đơn hàng đã hủy nhưng đã nhận tiền. Cần kiểm tra và xử lý hoàn tiền cho khách hàng.</strong>
        <p>Hệ thống giữ nguyên trạng thái đã thanh toán để đối soát và không tự động hoàn tiền. Liên hệ khách hàng, thực hiện hoàn tiền qua ngân hàng hoặc phương thức phù hợp và lưu chứng từ.</p>
    </div>
}
<div class="detail-grid">
    <section class="panel padded">
        <h2>Khách hàng &amp; giao nhận</h2>
        <dl class="info-list">
            <div><dt>Họ và tên</dt><dd>@(Model.Customer != null ? Model.Customer.CustomerName : "—")</dd></div>
            <div><dt>Điện thoại</dt><dd>@(Model.Customer != null ? Model.Customer.CustomerPhone : "—")</dd></div>
            <div><dt>Địa chỉ nhận hàng</dt><dd>@Model.AddressDelivery</dd></div>
            <div><dt>Phương thức</dt><dd>@PaymentMethodName(Model.PaymentMethod)</dd></div>
            <div><dt>Thanh toán</dt><dd><span class="badge @(isPaid ? "good" : "")">@(isPaid ? "Đã thanh toán" : "Chưa thanh toán")</span></dd></div>
        </dl>
    </section>
    <section class="panel padded admin-orders-status-card">
        <h2>Cập nhật trạng thái</h2>
        @if (isBankTransfer && !isPaid && !isCancelled)
        {
            <div class="notice error" role="status"><strong>Chờ xác minh tiền chuyển khoản.</strong><p>Chỉ chuyển sang xử lý, đang giao hoặc đã giao sau khi xác nhận đã thực nhận đủ tiền.</p></div>
        }
        @if (canChangeStatus)
        {
            <p class="form-note">Mở trang cập nhật để chọn trạng thái tiếp theo phù hợp cho đơn hàng.</p>
            <div class="admin-orders-status-actions"><a class="button primary" href="@Url.Action("UpdateStatus", "Orders", new { area = "Admin", id = Model.OrderID })">Cập nhật trạng thái →</a></div>
            <p class="form-note">Hủy đơn sẽ hoàn lại tồn kho. Nếu đã nhận tiền, trạng thái thanh toán được giữ nguyên và quản trị viên cần xử lý hoàn tiền riêng.</p>
            if (isCod)
            {
                <p class="form-note">Với COD, xác nhận đã giao đồng thời ghi nhận đã thu tiền từ khách hàng.</p>
            }
        }
        else if (isBankTransfer && !isPaid && Model.OrderStatus == "Shipping")
        {
            <p class="muted">Đơn đang giao chưa được xác nhận tiền chuyển khoản. Hãy kiểm tra thực nhận và xác nhận thanh toán trước khi tiếp tục.</p>
        }
        else if (Model.OrderStatus == "Delivered" || isCancelled)
        {
            <p class="muted">Đơn hàng đã kết thúc, không thể chuyển trạng thái.</p>
        }
        else
        {
            <p class="muted">Không có trạng thái tiếp theo phù hợp. Vui lòng kiểm tra phương thức thanh toán của đơn hàng.</p>
        }
    </section>
</div>
@if (isBankTransfer)
{
    <p class="form-note">Nội dung chuyển khoản để đối chiếu: <strong>@LTW_25DH110785.Services.PaymentRules.TransferReference(Model.OrderID)</strong></p>
    <section class="panel padded">
        <h2>Đối soát chuyển khoản ngân hàng</h2>
        @if (!isPaid && !isCancelled)
        {
            <p>Trước khi xác nhận, quản trị viên phải kiểm tra tài khoản ngân hàng và đối chiếu đúng đơn hàng, nội dung chuyển khoản cùng số tiền thực nhận <strong>@Model.TotalAmount.ToString("N0") ₫</strong>.</p>
            <p class="form-note">Quét mã QR hoặc thông báo của khách hàng không thay thế việc đối chiếu số tiền thực nhận trên tài khoản ngân hàng.</p>
            using (Html.BeginForm("ConfirmPayment", "Orders", new { area = "Admin", id = Model.OrderID }, FormMethod.Post, new { onsubmit = "return confirm('Tôi đã kiểm tra tài khoản ngân hàng và thực nhận đủ số tiền của đơn hàng. Xác nhận đã nhận đủ tiền?');" }))
            {
                @Html.AntiForgeryToken()
                <button class="button primary" type="submit">Xác nhận đã nhận đủ tiền</button>
            }
        }
        else if (isPaid)
        {
            <p><span class="badge good">Đã thanh toán</span> Đã xác nhận nhận đủ tiền chuyển khoản cho đơn hàng này.</p>
            if (isCancelled)
            {
                <p class="form-note"><strong>Cần xử lý hoàn tiền riêng; hệ thống không tự động hoàn tiền khi hủy đơn.</strong></p>
            }
        }
        else
        {
            <p class="muted">Đơn đã hủy và chưa ghi nhận thanh toán. Không thể xác nhận nhận tiền trên đơn đã hủy.</p>
        }
    </section>
}
<section class="panel">
    <div class="panel-heading"><h2>Linh kiện trong đơn</h2><span>@Model.OrderDetails.Sum(x => x.Quantity) sản phẩm</span></div>
    <div class="table-scroll">
        <table>
            <thead><tr><th>Sản phẩm</th><th class="right">Đơn giá</th><th class="right">Số lượng</th><th class="right">Thành tiền</th></tr></thead>
            <tbody>
                @foreach (var item in Model.OrderDetails)
                {
                    <tr><td class="strong">@(item.Product != null ? item.Product.ProductName : "Sản phẩm #" + item.ProductID)</td><td class="right">@item.UnitPrice.ToString("N0") ₫</td><td class="right">@item.Quantity</td><td class="right strong">@((item.Quantity * item.UnitPrice).ToString("N0")) ₫</td></tr>
                }
            </tbody>
            <tfoot><tr><td colspan="3" class="right">Tổng thanh toán</td><td class="right total">@Model.TotalAmount.ToString("N0") ₫</td></tr></tfoot>
        </table>
    </div>
</section>
</div>
@functions {
    public string PaymentMethodName(string method)
    {
        switch (method) { case "COD": return "Thanh toán khi nhận hàng (COD)"; case "BankTransfer": return "Chuyển khoản ngân hàng"; default: return "Chưa xác định"; }
    }
    public string StatusName(string s)
    {
        switch (s) { case "Pending": return "Chờ xác nhận"; case "Processing": return "Đang xử lý"; case "Shipping": return "Đang giao"; case "Delivered": return "Đã giao"; case "Cancelled": return "Đã hủy"; default: return s; }
    }
}
