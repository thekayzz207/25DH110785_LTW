@model LTW_25DH110785.Areas.Admin.Models.PagedListVM<LTW_25DH110785.Models.Order>
@{ ViewBag.Title = "Đơn hàng"; int? customerId = ViewBag.CustomerId as int?; }
<div class="page-heading"><div><p class="eyebrow">VẬN HÀNH CỬA HÀNG</p><h1>Đơn hàng<span>.</span></h1><p>@Model.TotalItems đơn hàng @(customerId.HasValue ? "của khách hàng #" + customerId.Value : "trong hệ thống").</p></div>@if (customerId.HasValue) { <a class="button secondary" href="@Url.Action("Index", "Orders", new { area = "Admin" })">Xem tất cả đơn</a> }</div>
<section class="panel"><form class="filterbar" method="get" action="@Url.Action("Index", "Orders", new { area = "Admin" })">@if (customerId.HasValue) { <input type="hidden" name="customerId" value="@customerId.Value"/> }<label class="search-field"><span class="sr-only">Tìm đơn hàng</span><input name="q" value="@Model.Q" placeholder="Mã đơn, tên khách hoặc số điện thoại…"/></label><label><span class="sr-only">Sắp xếp đơn hàng</span>@Html.DropDownList("sort", new[] { new SelectListItem { Text = "Mới nhất", Value = "newest", Selected = Model.Sort == "newest" }, new SelectListItem { Text = "Cũ nhất", Value = "oldest", Selected = Model.Sort == "oldest" }, new SelectListItem { Text = "Giá trị giảm dần", Value = "total_desc", Selected = Model.Sort == "total_desc" }, new SelectListItem { Text = "Giá trị tăng dần", Value = "total_asc", Selected = Model.Sort == "total_asc" } })</label><button class="button secondary" type="submit">Tìm kiếm</button></form><div class="table-scroll"><table><thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Ngày đặt</th><th>Trạng thái</th><th>Phương thức / Thanh toán</th><th class="right">Tổng tiền</th><th></th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td class="strong">#NX-@item.OrderID.ToString("D5")</td><td>@(item.Customer != null ? item.Customer.CustomerName : "—")</td><td>@item.OrderDate.AddHours(7).ToString("dd/MM/yyyy")</td><td><span class="badge @(item.OrderStatus == "Delivered" ? "good" : item.OrderStatus == "Cancelled" ? "danger" : "")">@StatusName(item.OrderStatus)</span></td><td><span>@PaymentMethodName(item.PaymentMethod)</span><small class="cell-small"><span class="badge @(item.PaymentStatus == "Paid" ? "good" : "")">@(item.PaymentStatus == "Paid" ? "Đã thanh toán" : "Chưa thanh toán")</span></small>@if (item.OrderStatus == "Cancelled" && item.PaymentStatus == "Paid") { <small class="cell-small"><strong>Cần xử lý hoàn tiền</strong></small> }</td><td class="right strong">@item.TotalAmount.ToString("N0") ₫</td><td><a class="button small secondary" href="@Url.Action("Details", "Orders", new { area = "Admin", id = item.OrderID })">Chi tiết →</a></td></tr> }@if (!Model.Items.Any()) { <tr><td colspan="7" class="empty">Không có đơn hàng phù hợp.</td></tr> }</tbody></table></div><div class="pagination"><span>Trang @Model.Page / @Model.TotalPages</span><nav aria-label="Phân trang đơn hàng">@if (Model.Page > 1) { <a href="@Url.Action("Index", new { area = "Admin", q = Model.Q, sort = Model.Sort, customerId = customerId, page = Model.Page - 1 })">← Trước</a> }@for (int p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++) { <a class="@(p == Model.Page ? "current" : "")" href="@Url.Action("Index", new { area = "Admin", q = Model.Q, sort = Model.Sort, customerId = customerId, page = p })">@p</a> }@if (Model.Page < Model.TotalPages) { <a href="@Url.Action("Index", new { area = "Admin", q = Model.Q, sort = Model.Sort, customerId = customerId, page = Model.Page + 1 })">Sau →</a> }</nav></div></section>
@functions { public string PaymentMethodName(string method) { switch (method) { case "COD": return "Thu tiền khi nhận hàng (COD)"; case "BankTransfer": return "Chuyển khoản ngân hàng"; default: return "Chưa xác định"; } } public string StatusName(string s) { switch (s) { case "Pending": return "Chờ xác nhận"; case "Processing": return "Đang xử lý"; case "Shipping": return "Đang giao"; case "Delivered": return "Đã giao"; case "Cancelled": return "Đã hủy"; default: return s; } } }
