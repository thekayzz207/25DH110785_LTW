@model LTW_25DH110785.Areas.Admin.Models.ProductFormVM
@{ bool edit = ViewBag.IsEdit == true; ViewBag.Title = edit ? "Sửa sản phẩm" : "Thêm sản phẩm"; }
<div class="page-heading"><div><p class="eyebrow">DANH MỤC LINH KIỆN</p><h1>@ViewBag.Title<span>.</span></h1><p>Thông tin rõ ràng giúp khách chọn đúng linh kiện.</p></div><a class="button secondary" href="@Url.Action("Index", "Products", new { area = "Admin" })">← Danh sách</a></div>
@using (Html.BeginForm(edit ? "Edit" : "Create", "Products", new { area = "Admin", id = Model.ProductID }, FormMethod.Post, new { enctype = "multipart/form-data", @class = "panel form-panel" })) {
@Html.AntiForgeryToken() @Html.HiddenFor(m => m.ProductID) @Html.HiddenFor(m => m.RowVersionToken) @Html.ValidationSummary(false, "Vui lòng kiểm tra thông tin.", new { @class = "validation-summary" })
<div class="form-grid"><div class="field full">@Html.LabelFor(m => m.ProductName, "Tên sản phẩm") @Html.TextBoxFor(m => m.ProductName, new { maxlength = 200, required = "required" }) @Html.ValidationMessageFor(m => m.ProductName)</div><div class="field">@Html.LabelFor(m => m.CategoryID, "Danh mục") @Html.DropDownListFor(m => m.CategoryID, (SelectList)ViewBag.Categories, "Chọn danh mục") @Html.ValidationMessageFor(m => m.CategoryID)</div><div class="field">@Html.LabelFor(m => m.Brand, "Thương hiệu") @Html.TextBoxFor(m => m.Brand, new { maxlength = 100 }) @Html.ValidationMessageFor(m => m.Brand)</div><div class="field">@Html.LabelFor(m => m.ProductPrice, "Giá bán (VNĐ)") <input type="number" id="ProductPrice" name="ProductPrice" value="@(Model.ProductPrice.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" min="1" max="1000000000" step="1" required="required"/> @Html.ValidationMessageFor(m => m.ProductPrice)</div><div class="field">@Html.LabelFor(m => m.StockQuantity, "Số lượng tồn kho") @Html.TextBoxFor(m => m.StockQuantity, new { type = "number", min = "0", max = "100000", step = "1", required = "required" }) @Html.ValidationMessageFor(m => m.StockQuantity)</div><div class="field">@Html.LabelFor(m => m.DeviceType, "Thiết bị sử dụng") @Html.DropDownListFor(m => m.DeviceType, new[] { new SelectListItem { Value = "PC", Text = "Máy tính PC" }, new SelectListItem { Value = "Laptop", Text = "Laptop" }, new SelectListItem { Value = "Both", Text = "Laptop và PC" } }) @Html.ValidationMessageFor(m => m.DeviceType)</div><div class="field"><label for="ImageFile">Ảnh sản phẩm</label><input id="ImageFile" name="ImageFile" type="file" accept="image/png,image/jpeg,image/webp"/><small>PNG, JPEG hoặc WebP · Tối đa 2 MB. Bỏ trống để giữ ảnh hiện tại.</small>@Html.ValidationMessageFor(m => m.ImageFile)@if (!String.IsNullOrEmpty(Model.ProductImage)) { <img class="image-preview" src="@Url.Content(Model.ProductImage)" alt="Ảnh sản phẩm hiện tại"/> }</div><div class="field full">@Html.LabelFor(m => m.ProductDecription, "Mô tả sản phẩm") @Html.TextAreaFor(m => m.ProductDecription, new { rows = 5 }) @Html.ValidationMessageFor(m => m.ProductDecription)</div><div class="field full">@Html.LabelFor(m => m.Specifications, "Thông số kỹ thuật") @Html.TextAreaFor(m => m.Specifications, new { rows = 5, placeholder = "Mỗi thông số một dòng. Ví dụ: Dung lượng: 16GB" }) @Html.ValidationMessageFor(m => m.Specifications)</div><label class="checkbox-field full">@Html.CheckBoxFor(m => m.IsActive) Hiển thị và cho phép đặt mua sản phẩm</label></div><div class="form-actions"><a class="button secondary" href="@Url.Action("Index", "Products", new { area = "Admin" })">Hủy</a><button class="button primary" type="submit">@(edit ? "Lưu thay đổi" : "Tạo sản phẩm") →</button></div> }
