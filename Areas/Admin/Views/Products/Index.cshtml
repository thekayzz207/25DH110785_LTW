@model LTW_25DH110785.Areas.Admin.Models.PagedListVM<LTW_25DH110785.Models.Product>
@{ ViewBag.Title = "Sản phẩm"; }
<div class="page-heading"><div><p class="eyebrow">QUẢN LÝ HÀNG HÓA</p><h1>Sản phẩm<span>.</span></h1><p>@Model.TotalItems sản phẩm trong hệ thống.</p></div><a class="button primary" href="@Url.Action("Create", "Products", new { area = "Admin" })">+ Thêm sản phẩm</a></div>
<section class="panel"><form class="filterbar" method="get" action="@Url.Action("Index", "Products", new { area = "Admin" })"><label class="search-field"><span class="sr-only">Tìm sản phẩm</span><input name="q" value="@Model.Q" placeholder="Tìm tên hoặc thương hiệu…"/></label><label><span class="sr-only">Sắp xếp</span>@Html.DropDownList("sort", new[] { new SelectListItem { Text = "Mới nhất", Value = "newest", Selected = Model.Sort == "newest" }, new SelectListItem { Text = "Tên A → Z", Value = "name", Selected = Model.Sort == "name" }, new SelectListItem { Text = "Giá tăng dần", Value = "price_asc", Selected = Model.Sort == "price_asc" }, new SelectListItem { Text = "Giá giảm dần", Value = "price_desc", Selected = Model.Sort == "price_desc" }, new SelectListItem { Text = "Tồn kho thấp nhất", Value = "stock", Selected = Model.Sort == "stock" } })</label><button class="button secondary" type="submit">Tìm kiếm</button></form>
<div class="table-scroll"><table><thead><tr><th>Sản phẩm</th><th>Danh mục</th><th>Thiết bị</th><th class="right">Giá bán</th><th>Tồn kho</th><th>Hiển thị</th><th>Thao tác</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td><div class="product-cell"><img src="@Url.Content(item.ProductImage ?? "~/Content/images/cpu.svg")" alt=""/><div><a class="table-link" href="@Url.Action("Edit", "Products", new { area = "Admin", id = item.ProductID })">@item.ProductName</a><small>@item.Brand · #@item.ProductID</small></div></div></td><td>@(item.Category != null ? item.Category.CategoryName : "—")</td><td>@item.DeviceType</td><td class="right strong">@item.ProductPrice.ToString("N0") ₫</td><td><span class="@(item.StockQuantity == 0 ? "badge danger" : "")">@item.StockQuantity</span></td><td><span class="badge @(item.IsActive ? "good" : "")">@(item.IsActive ? "Đang bán" : "Đã ẩn")</span></td><td><div class="actions"><a class="button small secondary" href="@Url.Action("Edit", "Products", new { area = "Admin", id = item.ProductID })">Sửa</a>@using (Html.BeginForm("Delete", "Products", new { area = "Admin", id = item.ProductID }, FormMethod.Post, new { onsubmit = "return confirm('Xóa sản phẩm này? Sản phẩm đã có đơn hàng sẽ được ẩn.');" })) { @Html.AntiForgeryToken()<button type="submit" class="button small danger">Xóa</button> }</div></td></tr> }@if (!Model.Items.Any()) { <tr><td colspan="7" class="empty">Không tìm thấy sản phẩm phù hợp.</td></tr> }</tbody></table></div>
<div class="pagination"><span>Trang @Model.Page / @Model.TotalPages</span><nav aria-label="Phân trang sản phẩm">@if (Model.Page > 1) { <a href="@Url.Action("Index", new { area = "Admin", q = Model.Q, sort = Model.Sort, page = Model.Page - 1 })">← Trước</a> }@for (int p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++) { <a class="@(p == Model.Page ? "current" : "")" href="@Url.Action("Index", new { area = "Admin", q = Model.Q, sort = Model.Sort, page = p })">@p</a> }@if (Model.Page < Model.TotalPages) { <a href="@Url.Action("Index", new { area = "Admin", q = Model.Q, sort = Model.Sort, page = Model.Page + 1 })">Sau →</a> }</nav></div></section>
