@model LTW_25DH110785.Areas.Admin.Models.AdminUserVM
@{ bool edit = ViewBag.IsEdit == true; ViewBag.Title = edit ? "Đổi mật khẩu admin" : "Thêm quản trị viên"; }
<div class="page-heading"><div><p class="eyebrow">QUYỀN TRUY CẬP</p><h1>@ViewBag.Title<span>.</span></h1><p>Tài khoản này có quyền quản lý sản phẩm và đơn hàng.</p></div><a class="button secondary" href="@Url.Action("Index", "Users", new { area = "Admin" })">← Danh sách</a></div>
@using (Html.BeginForm(edit ? "Edit" : "Create", "Users", new { area = "Admin", id = Model.Username }, FormMethod.Post, new { @class = "panel form-panel narrow" })) { @Html.AntiForgeryToken() @Html.ValidationSummary(false, "", new { @class = "validation-summary" })<div class="field">@Html.LabelFor(m => m.Username, "Tên đăng nhập") @if (edit) { @Html.TextBoxFor(m => m.Username, new { @readonly = "readonly", autocomplete = "username" }) } else { @Html.TextBoxFor(m => m.Username, new { maxlength = 100, autocomplete = "username", required = "required" }) } @Html.ValidationMessageFor(m => m.Username)</div><div class="field">@Html.LabelFor(m => m.Password, "Mật khẩu mới") @if (edit) { @Html.PasswordFor(m => m.Password, new { autocomplete = "new-password", minlength = 10, maxlength = 128 }) } else { @Html.PasswordFor(m => m.Password, new { autocomplete = "new-password", required = "required", minlength = 10, maxlength = 128 }) } @Html.ValidationMessageFor(m => m.Password)<small>Tối thiểu 10 ký tự. @(edit ? "Để trống cả hai ô để giữ mật khẩu hiện tại." : "Mật khẩu được lưu bằng hàm băm có salt.")</small></div><div class="field">@Html.LabelFor(m => m.ConfirmPassword, "Nhập lại mật khẩu") @if (edit) { @Html.PasswordFor(m => m.ConfirmPassword, new { autocomplete = "new-password", maxlength = 128 }) } else { @Html.PasswordFor(m => m.ConfirmPassword, new { autocomplete = "new-password", required = "required", maxlength = 128 }) } @Html.ValidationMessageFor(m => m.ConfirmPassword)</div><div class="form-actions"><a class="button secondary" href="@Url.Action("Index", "Users", new { area = "Admin" })">Hủy</a><button type="submit" class="button primary">Lưu tài khoản →</button></div> }
