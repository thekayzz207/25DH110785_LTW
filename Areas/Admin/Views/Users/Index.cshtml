@model LTW_25DH110785.Areas.Admin.Models.PagedListVM<LTW_25DH110785.Models.User>
@{ ViewBag.Title = "Tài khoản admin"; }
<div class="page-heading"><div><p class="eyebrow">QUYỀN TRUY CẬP</p><h1>Tài khoản quản trị<span>.</span></h1><p>@Model.TotalItems tài khoản admin · Quản lý quyền vận hành cửa hàng.</p></div><a class="button primary" href="@Url.Action("Create", "Users", new { area = "Admin" })">+ Thêm admin</a></div>
<section class="panel"><form method="get" class="filterbar" action="@Url.Action("Index", "Users", new { area = "Admin" })"><label class="search-field"><span class="sr-only">Tên đăng nhập</span><input name="q" value="@Model.Q" placeholder="Tìm theo tên đăng nhập…"/></label><label><span class="sr-only">Sắp xếp tài khoản</span>@Html.DropDownList("sort", new[] { new SelectListItem { Text = "Tên A → Z", Value = "name", Selected = Model.Sort == "name" }, new SelectListItem { Text = "Tên Z → A", Value = "name_desc", Selected = Model.Sort == "name_desc" } })</label><button class="button secondary" type="submit">Tìm kiếm</button></form><div class="table-scroll"><table><thead><tr><th>Tên đăng nhập</th><th>Vai trò</th><th>Thao tác</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td class="strong">@item.Username @if (item.Username == User.Identity.Name) { <span class="badge good">Bạn</span> }</td><td>Quản trị viên</td><td><div class="actions"><a class="button small secondary" href="@Url.Action("Edit", "Users", new { area = "Admin", id = item.Username })">Đổi mật khẩu</a>@if (item.Username != User.Identity.Name) { using (Html.BeginForm("Delete", "Users", new { area = "Admin", id = item.Username }, FormMethod.Post, new { onsubmit = "return confirm('Xóa tài khoản quản trị này?');" })) { @Html.AntiForgeryToken()<button type="submit" class="button small danger">Xóa</button> } }</div></td></tr> }@if (!Model.Items.Any()) { <tr><td colspan="3" class="empty">Không có tài khoản phù hợp.</td></tr> }</tbody></table></div><div class="pagination"><span>Trang @Model.Page / @Model.TotalPages</span><nav aria-label="Phân trang admin">@if (Model.Page > 1) { <a href="@Url.Action("Index", new { area = "Admin", q = Model.Q, sort = Model.Sort, page = Model.Page - 1 })">← Trước</a> }@if (Model.Page < Model.TotalPages) { <a href="@Url.Action("Index", new { area = "Admin", q = Model.Q, sort = Model.Sort, page = Model.Page + 1 })">Sau →</a> }</nav></div></section>
