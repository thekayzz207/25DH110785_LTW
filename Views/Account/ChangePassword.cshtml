@model LTW_25DH110785.ViewModels.ChangePasswordVM
@{ ViewBag.Title = "Đổi mật khẩu"; }
<div class="container narrow-page"><div class="page-heading"><span class="eyebrow">TÀI KHOẢN ANHKHOASTORE</span><h1>Đổi mật khẩu<span>.</span></h1></div><nav class="account-tabs">@if (User.IsInRole("A")) {<a href="@Url.Action("Index","Home",new {area="Admin"})">Bảng quản trị</a>} else {<a href="@Url.Action("Profile")">Hồ sơ</a>}<a class="active" href="@Url.Action("ChangePassword")">Đổi mật khẩu</a>@if (!User.IsInRole("A")) {<a href="@Url.Action("History","Order")">Đơn hàng</a>}</nav><section class="panel">@using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post)) { @Html.AntiForgeryToken() @Html.ValidationSummary(false,"",new { @class="validation-summary" })<div class="form-field">@Html.LabelFor(m=>m.CurrentPassword,"Mật khẩu hiện tại") @Html.PasswordFor(m=>m.CurrentPassword,new { autocomplete="current-password",required="required" }) @Html.ValidationMessageFor(m=>m.CurrentPassword)</div><div class="form-field">@Html.LabelFor(m=>m.NewPassword,"Mật khẩu mới") @Html.PasswordFor(m=>m.NewPassword,new { autocomplete="new-password",required="required" }) @Html.ValidationMessageFor(m=>m.NewPassword)</div><div class="form-field">@Html.LabelFor(m=>m.ConfirmPassword,"Nhập lại mật khẩu mới") @Html.PasswordFor(m=>m.ConfirmPassword,new { autocomplete="new-password",required="required" }) @Html.ValidationMessageFor(m=>m.ConfirmPassword)</div><button class="button primary" type="submit">Đổi mật khẩu <span>→</span></button> }</section></div>