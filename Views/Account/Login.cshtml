@model LTW_25DH110785.ViewModels.LoginVM
@{ ViewBag.Title = "Đăng nhập"; }
<div class="container auth-page"><div class="auth-story"><span class="eyebrow">CHÀO MỪNG ĐẾN ANHKHOASTORE</span><h1>Chào mừng<br />bạn <em>trở lại.</em></h1><p>Đăng nhập để lưu thông tin nhận hàng, đặt mua linh kiện và theo dõi mọi đơn hàng của bạn.</p><div class="auth-art"><img class="auth-logo" src="@Url.Content("~/Content/images/logo-k.svg")" alt="" width="92" height="92" /><small>BUILD YOUR NEXT.</small></div></div><section class="auth-card"><span class="eyebrow">TÀI KHOẢN CỦA BẠN</span><h2>Đăng nhập</h2><p class="muted">Bản nâng cấp tiếp theo đang chờ bạn.</p>@using (Html.BeginForm("Login", "Account", FormMethod.Post)) { @Html.AntiForgeryToken() @Html.HiddenFor(m=>m.ReturnUrl) @Html.ValidationSummary(false,"",new { @class="validation-summary" })<div class="form-field">@Html.LabelFor(m=>m.Username,"Tên đăng nhập") @Html.TextBoxFor(m=>m.Username,new { autocomplete="username", required="required", placeholder="Nhập tên đăng nhập" }) @Html.ValidationMessageFor(m=>m.Username)</div><div class="form-field">@Html.LabelFor(m=>m.Password,"Mật khẩu") @Html.PasswordFor(m=>m.Password,new { autocomplete="current-password",required="required",placeholder="Nhập mật khẩu" }) @Html.ValidationMessageFor(m=>m.Password)</div><button class="button primary full" type="submit">Đăng nhập <span>→</span></button> }<p class="form-switch">Bạn chưa có tài khoản? <a href="@Url.Action("Register")">Đăng ký ngay ↗</a></p></section></div>