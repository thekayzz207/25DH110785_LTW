@model LTW_25DH110785.ViewModels.ProfileVM
@{ ViewBag.Title = "Thông tin tài khoản"; }
<div class="container narrow-page"><div class="page-heading"><span class="eyebrow">TÀI KHOẢN ANHKHOASTORE</span><h1>Thông tin cá nhân<span>.</span></h1><p>Quản lý thông tin liên hệ và địa chỉ nhận hàng của bạn.</p></div><nav class="account-tabs"><a class="active" href="@Url.Action("Profile")">Hồ sơ</a><a href="@Url.Action("ChangePassword")">Đổi mật khẩu</a><a href="@Url.Action("History","Order")">Đơn hàng</a></nav><section class="panel">@using (Html.BeginForm("Profile", "Account", FormMethod.Post)) { @Html.AntiForgeryToken() @Html.ValidationSummary(false,"",new { @class="validation-summary" })<div class="form-grid"><div class="form-field">@Html.LabelFor(m=>m.CustomerName,"Họ và tên") @Html.TextBoxFor(m=>m.CustomerName,new { autocomplete="name",required="required" }) @Html.ValidationMessageFor(m=>m.CustomerName)</div><div class="form-field">@Html.LabelFor(m=>m.CustomerPhone,"Số điện thoại") @Html.TextBoxFor(m=>m.CustomerPhone,new { autocomplete="tel",type="tel",required="required" }) @Html.ValidationMessageFor(m=>m.CustomerPhone)</div></div><div class="form-field">@Html.LabelFor(m=>m.CustomerEmail,"Email") @Html.TextBoxFor(m=>m.CustomerEmail,new { autocomplete="email",type="email" }) @Html.ValidationMessageFor(m=>m.CustomerEmail)</div><div class="form-field">@Html.LabelFor(m=>m.CustomerAddress,"Địa chỉ nhận hàng") @Html.TextAreaFor(m=>m.CustomerAddress,new { rows=3,autocomplete="street-address" }) @Html.ValidationMessageFor(m=>m.CustomerAddress)</div><button class="button primary" type="submit">Lưu thay đổi <span>→</span></button> }</section></div>