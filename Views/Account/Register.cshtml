@model LTW_25DH110785.ViewModels.RegisterVM
@{ ViewBag.Title = "Đăng ký tài khoản"; }
<div class="container narrow-page"><nav class="breadcrumbs"><a href="@Url.Action("Index","Home")">Trang chủ</a><span>/</span><span>Đăng ký</span></nav><div class="page-heading"><span class="eyebrow">JOIN THE NEXT UPGRADE</span><h1>Tạo tài khoản<span>.</span></h1><p>Thông tin của bạn giúp việc đặt hàng nhanh hơn.</p></div><section class="panel">@using (Html.BeginForm("Register", "Account", FormMethod.Post)) { @Html.AntiForgeryToken() @Html.ValidationSummary(false,"",new { @class="validation-summary" })<h2 class="form-section-title">01 / Thông tin đăng nhập</h2><div class="form-field">@Html.LabelFor(m=>m.Username,"Tên đăng nhập") @Html.TextBoxFor(m=>m.Username,new { autocomplete="username",required="required",placeholder="Ví dụ: minhnguyen" }) @Html.ValidationMessageFor(m=>m.Username)</div><div class="form-grid"><div class="form-field">@Html.LabelFor(m=>m.Password,"Mật khẩu") @Html.PasswordFor(m=>m.Password,new { autocomplete="new-password",required="required" }) @Html.ValidationMessageFor(m=>m.Password)</div><div class="form-field">@Html.LabelFor(m=>m.ConfirmPassword,"Nhập lại mật khẩu") @Html.PasswordFor(m=>m.ConfirmPassword,new { autocomplete="new-password",required="required" }) @Html.ValidationMessageFor(m=>m.ConfirmPassword)</div></div><h2 class="form-section-title">02 / Thông tin nhận hàng</h2><div class="form-grid"><div class="form-field">@Html.LabelFor(m=>m.CustomerName,"Họ và tên") @Html.TextBoxFor(m=>m.CustomerName,new { autocomplete="name",required="required" }) @Html.ValidationMessageFor(m=>m.CustomerName)</div><div class="form-field">@Html.LabelFor(m=>m.CustomerPhone,"Số điện thoại") @Html.TextBoxFor(m=>m.CustomerPhone,new { autocomplete="tel",type="tel",required="required" }) @Html.ValidationMessageFor(m=>m.CustomerPhone)</div></div><div class="form-field">@Html.LabelFor(m=>m.CustomerEmail,"Email (không bắt buộc)") @Html.TextBoxFor(m=>m.CustomerEmail,new { autocomplete="email",type="email" }) @Html.ValidationMessageFor(m=>m.CustomerEmail)</div><div class="form-field">@Html.LabelFor(m=>m.CustomerAddress,"Địa chỉ") @Html.TextAreaFor(m=>m.CustomerAddress,new { autocomplete="street-address",rows=3 }) @Html.ValidationMessageFor(m=>m.CustomerAddress)</div><button class="button primary full" type="submit">Tạo tài khoản <span>→</span></button> }<p class="form-switch">Đã có tài khoản? <a href="@Url.Action("Login")">Đăng nhập</a></p></section></div>