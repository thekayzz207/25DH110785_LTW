@model LTW_25DH110785.ViewModels.ProductDetailVM
@using System.Globalization
@{ ViewBag.Title = Model.Product.ProductName; var p = Model.Product; }
<div class="container page-space"><nav class="breadcrumbs" aria-label="Đường dẫn"><a href="@Url.Action("Index")">Trang chủ</a><span>/</span><a href="@Url.Action("Index", new { categoryId=p.CategoryID })">@(p.Category == null ? "Linh kiện" : p.Category.CategoryName)</a><span>/</span><span>@p.ProductName</span></nav><div class="detail-grid"><div class="detail-image"><span class="product-tag">@(p.DeviceType == "Both" ? "PC & LAPTOP" : p.DeviceType.ToUpperInvariant())</span><img src="@Url.Content(string.IsNullOrWhiteSpace(p.ProductImage) ? "~/Content/images/cpu.svg" : p.ProductImage)" alt="@p.ProductName" /></div><div class="detail-copy"><span class="eyebrow">@p.Brand · MÃ SP NX-@p.ProductID.ToString("D4")</span><h1>@p.ProductName</h1><p class="detail-description">@p.ProductDecription</p><div class="product-stock"><i class="@(p.StockQuantity > 0 ? "available" : "unavailable")"></i>@(p.StockQuantity > 0 ? "Còn hàng · " + p.StockQuantity + " sản phẩm" : "Tạm hết hàng")</div><div class="detail-price">@p.ProductPrice.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) <span>₫</span></div><p class="muted">Giá sản phẩm. Phí vận chuyển: 0 ₫ trong bản thực hành.</p>@using (Html.BeginForm("Add", "Cart", new { area = "" }, FormMethod.Post, new { @class="detail-buy" })) { @Html.AntiForgeryToken()<input type="hidden" name="productId" value="@p.ProductID" /><input type="hidden" name="returnUrl" value="@Request.RawUrl" /><div class="quantity-control"><button type="button" data-quantity="minus" aria-label="Giảm số lượng">−</button><input type="number" name="quantity" value="1" min="1" max="@Math.Min(99,Math.Max(1,p.StockQuantity))" aria-label="Số lượng" /><button type="button" data-quantity="plus" aria-label="Tăng số lượng">+</button></div><button type="submit" class="button primary" disabled="@(p.StockQuantity <= 0 ? "disabled" : null)">Thêm vào giỏ hàng <span>+</span></button> }<div class="purchase-notes"><p><span>↗</span> Chọn linh kiện phù hợp chuẩn kết nối của thiết bị.</p><p><span>◷</span> Đăng nhập để đặt hàng và theo dõi trạng thái.</p><p><span>◇</span> Thanh toán khi nhận hàng (COD).</p></div></div></div><section class="specification-panel"><div><span class="eyebrow">HIỂU RÕ TRƯỚC KHI CHỌN</span><h2>Thông số kỹ thuật</h2></div><div class="specification-text">@p.Specifications</div></section>@if (Model.RelatedProducts.Count > 0) {<section class="related-section"><div class="section-heading"><div><span class="eyebrow">CÓ THỂ BẠN QUAN TÂM</span><h2>Linh kiện cùng danh mục<span>.</span></h2></div><a class="text-button" href="@Url.Action("Index", new { categoryId=p.CategoryID })">Xem tất cả →</a></div><div class="product-grid related-grid">@foreach (var related in Model.RelatedProducts) { @Html.Partial("_ProductCard", related) }</div></section>}</div>