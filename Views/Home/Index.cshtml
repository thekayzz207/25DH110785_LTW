@model LTW_25DH110785.ViewModels.CatalogVM
@using System.Globalization
@{ ViewBag.Title = "Linh kiện PC & Laptop"; var isFiltered = !string.IsNullOrWhiteSpace(Model.Q) || Model.CategoryId.HasValue || !string.IsNullOrWhiteSpace(Model.Device) || Model.MinPrice.HasValue || Model.MaxPrice.HasValue; }
@if (!isFiltered && Model.Page == 1) {
<section class="hero"><div class="container hero-grid"><div class="hero-copy"><span class="eyebrow"><i></i> BUILT FOR YOUR NEXT UPGRADE</span><h1>Linh kiện chuẩn.<br />Hiệu năng <em>vượt trội.</em></h1><p>Từ chiếc laptop mỗi ngày đến dàn PC trong mơ.<br class="desktop-only" /> Tìm linh kiện phù hợp cho mọi bản nâng cấp.</p><div class="hero-actions"><a class="button primary" href="#catalog">Khám phá linh kiện <span>↗</span></a><a class="text-button" href="@Url.Action("Index", new { device = "Laptop" })">Nâng cấp laptop <span>→</span></a></div><div class="hero-bottom"><div class="hero-count">PC<span>+</span>LT</div><p>Một nơi cho mọi<br /><strong>nhu cầu nâng cấp.</strong></p><span class="hero-vertical"></span><p>CPU · GPU · RAM · SSD<br /><strong>và nhiều hơn thế nữa</strong></p></div></div><div class="hero-visual"><div class="hero-circle"></div><img src="@Url.Content("~/Content/images/hero-components.svg")" alt="Bộ linh kiện máy tính gồm card đồ họa, bo mạch chủ, RAM và SSD" /><span class="hero-visual-foot">CHOOSE YOUR PARTS. BUILD YOUR POSSIBILITIES.</span></div></div></section>
<div class="brand-band"><div class="container brand-band-inner"><span>LỰA CHỌN THƯƠNG HIỆU</span><strong>intel<span>®</span></strong><strong>AMD</strong><strong>ASUS</strong><strong>CORSAIR</strong><strong>Kingston</strong><strong>SAMSUNG</strong></div></div>
}
<section class="catalog-section container" id="catalog"><div class="section-heading"><div><span class="eyebrow">CHỌN ĐÚNG LINH KIỆN</span><h2>@(isFiltered ? "Kết quả tìm kiếm" : "Khám phá linh kiện")<span>.</span></h2></div><span class="result-total">@Model.TotalItems sản phẩm dành cho bạn</span></div>
<div class="catalog-layout"><aside class="catalog-sidebar"><form method="get" action="@Url.Action("Index", "Home")" class="filter-form"><input type="hidden" name="q" value="@Model.Q" /><h3><span>☷</span> Bộ lọc sản phẩm</h3><fieldset><legend>Danh mục</legend><label class="filter-option"><input type="radio" name="categoryId" value="" checked="@(!Model.CategoryId.HasValue ? "checked" : null)" /><span>Tất cả linh kiện</span></label>@foreach (var c in Model.Categories) {<label class="filter-option"><input type="radio" name="categoryId" value="@c.CategoryID" checked="@(Model.CategoryId == c.CategoryID ? "checked" : null)" /><span>@c.CategoryName</span></label>}</fieldset><fieldset><legend>Dành cho thiết bị</legend><label class="filter-option"><input type="radio" name="device" value="" checked="@(string.IsNullOrEmpty(Model.Device) ? "checked" : null)" /><span>Tất cả thiết bị</span></label><label class="filter-option"><input type="radio" name="device" value="PC" checked="@(Model.Device == "PC" ? "checked" : null)" /><span>Máy tính để bàn / PC</span></label><label class="filter-option"><input type="radio" name="device" value="Laptop" checked="@(Model.Device == "Laptop" ? "checked" : null)" /><span>Laptop</span></label></fieldset><fieldset><legend>Khoảng giá (₫)</legend><div class="price-range"><input type="number" name="minPrice" min="0" value="@(Model.MinPrice.HasValue ? Model.MinPrice.Value.ToString(CultureInfo.InvariantCulture) : "")" placeholder="Từ" aria-label="Giá thấp nhất" /><span>—</span><input type="number" name="maxPrice" min="0" value="@(Model.MaxPrice.HasValue ? Model.MaxPrice.Value.ToString(CultureInfo.InvariantCulture) : "")" placeholder="Đến" aria-label="Giá cao nhất" /></div></fieldset><input type="hidden" name="sort" value="@Model.Sort" /><button class="button dark full" type="submit">Áp dụng bộ lọc <span>→</span></button><a class="clear-filter" href="@Url.Action("Index")">Xóa bộ lọc</a></form><div class="sidebar-note"><span>UPGRADE SMARTER.</span><h3>Nâng cấp nhỏ.<br />Khác biệt lớn.</h3><p>Kiểm tra chuẩn kết nối và khả năng tương thích của thiết bị trước khi chọn mua.</p><a href="@Url.Action("Index", new { device = "Laptop" })">Xem linh kiện laptop ↗</a></div></aside>
<div class="catalog-results"><div class="catalog-toolbar"><p>@if (!string.IsNullOrWhiteSpace(Model.Q)) {<span>Từ khóa: <strong>“@Model.Q”</strong></span>} else {<span><i class="status-dot"></i> Sẵn sàng cho bản nâng cấp của bạn</span>}</p><form method="get" action="@Url.Action("Index")"><input type="hidden" name="q" value="@Model.Q" /><input type="hidden" name="categoryId" value="@Model.CategoryId" /><input type="hidden" name="device" value="@Model.Device" /><input type="hidden" name="minPrice" value="@(Model.MinPrice.HasValue ? Model.MinPrice.Value.ToString(CultureInfo.InvariantCulture) : "")" /><input type="hidden" name="maxPrice" value="@(Model.MaxPrice.HasValue ? Model.MaxPrice.Value.ToString(CultureInfo.InvariantCulture) : "")" /><label for="sort">Sắp xếp:</label><select id="sort" name="sort"><option value="newest" selected="@(Model.Sort == "newest" ? "selected" : null)">Mới nhất</option><option value="price-asc" selected="@(Model.Sort == "price-asc" ? "selected" : null)">Giá tăng dần</option><option value="price-desc" selected="@(Model.Sort == "price-desc" ? "selected" : null)">Giá giảm dần</option><option value="name" selected="@(Model.Sort == "name" ? "selected" : null)">Tên A → Z</option></select><button class="sort-button" type="submit">Xem</button></form></div>
@if (Model.Products.Count == 0) {<div class="empty-state"><span class="empty-icon">⌕</span><h3>Chưa tìm thấy linh kiện phù hợp</h3><p>Thử từ khóa khác hoặc nới rộng khoảng giá để xem thêm sản phẩm.</p><a class="button primary" href="@Url.Action("Index")">Xem tất cả linh kiện →</a></div>} else {<div class="product-grid">@foreach (var p in Model.Products) { @Html.Partial("_ProductCard", p) }</div>}
@if (Model.TotalPages > 1) {<nav class="pagination" aria-label="Phân trang sản phẩm">@if (Model.Page > 1) {<a href="@Url.Action("Index", new { q=Model.Q,categoryId=Model.CategoryId,device=Model.Device,sort=Model.Sort,minPrice=Model.MinPrice,maxPrice=Model.MaxPrice,page=Model.Page-1 })" aria-label="Trang trước">←</a>}@for (var i = Math.Max(1, Model.Page-2); i <= Math.Min(Model.TotalPages, Model.Page+2); i++) {<a class="@(i == Model.Page ? "active" : "")" aria-current="@(i == Model.Page ? "page" : null)" href="@Url.Action("Index", new { q=Model.Q,categoryId=Model.CategoryId,device=Model.Device,sort=Model.Sort,minPrice=Model.MinPrice,maxPrice=Model.MaxPrice,page=i })">@i</a>}@if (Model.Page < Model.TotalPages) {<a href="@Url.Action("Index", new { q=Model.Q,categoryId=Model.CategoryId,device=Model.Device,sort=Model.Sort,minPrice=Model.MinPrice,maxPrice=Model.MaxPrice,page=Model.Page+1 })" aria-label="Trang sau">→</a>}</nav>}
</div></div></section>
<section class="upgrade-banner container"><div><span class="eyebrow">YOUR NEXT BUILD STARTS HERE</span><h2>Một bản nâng cấp.<br />Vô vàn khả năng.</h2><p>Tìm bộ nhớ, ổ cứng và linh kiện dành riêng cho chiếc laptop của bạn.</p><a class="button primary" href="@Url.Action("Index", new { device = "Laptop" })">Khám phá linh kiện laptop <span>↗</span></a></div><div class="upgrade-art"><span>RAM</span><b>+</b><span>SSD</span><small>MORE SPEED. MORE POSSIBILITIES.</small></div></section>
