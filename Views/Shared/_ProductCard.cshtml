@model LTW_25DH110785.Models.Product
@using System.Globalization
<article class="product-card">
    <a class="product-image" href="@Url.Action("Details", "Home", new { area = "", id = Model.ProductID })"><span class="product-tag">@(Model.DeviceType == "Both" ? "PC & LAPTOP" : Model.DeviceType.ToUpperInvariant())</span><img src="@Url.Content(string.IsNullOrWhiteSpace(Model.ProductImage) ? "~/Content/images/cpu.svg" : Model.ProductImage)" alt="@Model.ProductName" loading="lazy" /><span class="image-arrow" aria-hidden="true">↗</span></a>
    <div class="product-info"><span class="product-brand">@Model.Brand <span>· @(Model.Category == null ? "Linh kiện" : Model.Category.CategoryName)</span></span><h3><a href="@Url.Action("Details", "Home", new { area = "", id = Model.ProductID })">@Model.ProductName</a></h3><p class="product-description">@Model.ProductDecription</p><div class="product-stock"><i class="@(Model.StockQuantity > 0 ? "available" : "unavailable")"></i>@(Model.StockQuantity > 0 ? "Còn " + Model.StockQuantity + " sản phẩm" : "Tạm hết hàng")</div><div class="product-bottom"><strong>@Model.ProductPrice.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) <small>₫</small></strong>@using (Html.BeginForm("Add", "Cart", new { area = "" }, FormMethod.Post, new { @class = "add-form" })) { @Html.AntiForgeryToken()<input type="hidden" name="productId" value="@Model.ProductID" /><input type="hidden" name="quantity" value="1" /><input type="hidden" name="returnUrl" value="@Request.RawUrl" /><button class="add-button" type="submit" disabled="@(Model.StockQuantity <= 0 ? "disabled" : null)" aria-label="Thêm @Model.ProductName vào giỏ">+</button> }</div></div>
</article>